{
  "version": 1,
  "author": "Suzane Luz",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-dht22", "id": "dht1", "top": -115, "left": -140, "attrs": { "temperature": "26", "humidity": "55" } },
    { "type": "wokwi-photoresistor-sensor", "id": "ldr1", "top": 60, "left": -300, "attrs": {} },
    { "type": "wokwi-potentiometer", "id": "soil1", "top": 170, "left": -230, "attrs": {} },
    { "type": "wokwi-relay-module", "id": "relay1", "top": -90, "left": 220, "attrs": {} },
    { "type": "wokwi-led", "id": "led1", "top": 40, "left": 250, "attrs": { "color": "yellow" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 110, "left": 220, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-buzzer", "id": "bz1", "top": 160, "left": 300, "attrs": { "volume": "0.2" } },
    { "type": "board-ssd1306", "id": "oled1", "top": -140, "left": 60, "attrs": { "i2cAddress": "0x3c" } },
    { "type": "wokwi-pushbutton", "id": "btn1", "top": 250, "left": 180, "attrs": { "color": "blue" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "dht1:VCC", "esp:3V3", "red", [] ],
    [ "dht1:GND", "esp:GND.1", "black", [] ],
    [ "dht1:SDA", "esp:15", "green", [] ],

    [ "ldr1:VCC", "esp:3V3", "red", [] ],
    [ "ldr1:GND", "esp:GND.1", "black", [] ],
    [ "ldr1:AO", "esp:34", "orange", [] ],

    [ "soil1:VCC", "esp:3V3", "red", [] ],
    [ "soil1:GND", "esp:GND.1", "black", [] ],
    [ "soil1:SIG", "esp:35", "purple", [] ],

    [ "relay1:VCC", "esp:5V", "red", [] ],
    [ "relay1:GND", "esp:GND.2", "black", [] ],
    [ "relay1:IN", "esp:26", "blue", [] ],

    [ "esp:25", "r1:1", "yellow", [] ],
    [ "r1:2", "led1:A", "yellow", [] ],
    [ "led1:C", "esp:GND.2", "black", [] ],

    [ "bz1:2", "esp:27", "magenta", [] ],
    [ "bz1:1", "esp:GND.2", "black", [] ],

    [ "oled1:VCC", "esp:3V3", "red", [] ],
    [ "oled1:GND", "esp:GND.2", "black", [] ],
    [ "oled1:SDA", "esp:21", "blue", [ "v-15", "h160", "*" ] ],
    [ "oled1:SCL", "esp:22", "green", [ "v-10", "h170", "*" ] ],

    [ "btn1:1.l", "esp:4", "white", [] ],
    [ "btn1:2.l", "esp:GND.1", "black", [] ]
  ],
  "dependencies": {}
}
